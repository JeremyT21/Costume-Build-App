# Vision-capable LLM used by every agent, as a pydantic-ai "provider:model-name" string.
# Leave empty to run in offline mode. Also set the API key variable your provider expects.
# Provider list: https://ai.pydantic.dev/models/overview/
COSPAL_MODEL=

# Optional Amazon product data provider: "rainforest" or empty for search links.
AMAZON_PROVIDER=
RAINFOREST_API_KEY=
AMAZON_DOMAIN=amazon.com
AMAZON_ASSOCIATE_TAG=

# Frontend origin allowed by CORS.
CORS_ORIGINS=http://localhost:5173
